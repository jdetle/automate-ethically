# Serves the built Astro site on 8080 as the non-root nginx user.
# pid and temp paths live in /tmp because /var/run and /var/cache/nginx are
# not writable once USER nginx drops privileges.
#
# This is a TEMPLATE, not a config: docker-entrypoint.sh substitutes
# __S10_INGEST_KEY__ at container start and writes the result to /tmp. The
# ingest credential therefore lives in a Container Apps secret and reaches
# only this process — never the image, never the repository, never a browser.
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Do not advertise the nginx version to every caller; a version string is
    # free reconnaissance for anyone matching against known CVEs.
    server_tokens off;

    # $http_x_forwarded_for is the real client — ACA's Envoy ingress fronts
    # this container, so $remote_addr is always the ingress hop. This log
    # format is the whole analytics pipeline for anything s10 doesn't cover:
    # pull it with `az monitor log-analytics query` and pipe into GoAccess
    # locally when curious (see docs, not run in production).
    log_format main '$http_x_forwarded_for - [$time_local] '
                     '"$request" $status $body_bytes_sent '
                     '"$http_referer" "$http_user_agent"';
    access_log /dev/stdout main;
    sendfile on;
    tcp_nopush on;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    # The telemetry relay is the only path that reaches a backend, so it is
    # the only path worth flooding. Keyed on the forwarded client rather than
    # $remote_addr, which is always the ingress.
    limit_req_zone $http_x_forwarded_for zone=telemetry:1m rate=30r/m;
    # The guide calls a paid API per message; a real conversation is a handful
    # of messages a minute, not thirty. The app itself also holds a per-day
    # per-visitor cap and a global daily token budget (src/pages/api/guide.ts)
    # — this is the fast, cheap first line before either of those runs.
    limit_req_zone $http_x_forwarded_for zone=guide:1m rate=6r/m;
    limit_req_status 429;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json
               image/svg+xml text/plain text/xml application/xml;

    server {
        listen 8080;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        # Astro fingerprints everything under /_astro/, so those files can be
        # cached forever; a content change produces a new hash and a new URL.
        location /_astro/ {
            include /etc/nginx/security-headers.conf;
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }

        # Committed PDFs and the QR/OG images change occasionally, not never —
        # an hour and a day of staleness are both fine, a year is not.
        location /downloads/ {
            include /etc/nginx/security-headers.conf;
            add_header Cache-Control "public, max-age=3600, must-revalidate";
            try_files $uri =404;
        }

        location /og/ {
            include /etc/nginx/security-headers.conf;
            add_header Cache-Control "public, max-age=86400";
            try_files $uri =404;
        }

        # The pageview beacon in Base.astro posts here, and this is where the
        # ingest credential is attached — server side, where a secret can
        # actually stay secret. Deliberately not called `/_s10/` or otherwise
        # obfuscated: a site arguing against unaccountable automated systems
        # should stay easy to block, not evade blockers.
        #
        # Scoped to the exact endpoint and method the beacon uses. The old
        # `location /telemetry/` prefix relayed any method and any path to the
        # ingest service, which made this site a free amplifier for anyone who
        # found it.
        location = /telemetry/v2/envelopes {
            include /etc/nginx/security-headers.conf;

            limit_except POST { deny all; }
            limit_req zone=telemetry burst=10 nodelay;
            client_max_body_size 4k;

            # Forward nothing the caller sent. Without this a client could
            # smuggle its own Authorization, cookies, or forged forwarding
            # headers straight through to the ingest backend.
            proxy_pass_request_headers off;
            proxy_set_header Host ca-s10-ingest.purplewave-fe0ae338.eastus2.azurecontainerapps.io;
            proxy_set_header Content-Type "application/x-ndjson";
            proxy_set_header Authorization "Bearer __S10_INGEST_KEY__";

            proxy_ssl_server_name on;
            proxy_pass https://ca-s10-ingest.purplewave-fe0ae338.eastus2.azurecontainerapps.io/v2/envelopes;
        }

        # The one route with a real backend: src/pages/api/guide.ts, served by
        # the Node process docker-entrypoint.sh starts alongside nginx (see
        # that file). Streamed (SSE), so buffering has to be off or the whole
        # response would arrive in one burst at the end instead of live.
        location = /api/guide {
            include /etc/nginx/security-headers.conf;

            limit_except POST { deny all; }
            limit_req zone=guide burst=2 nodelay;
            client_max_body_size 16k;

            proxy_pass http://127.0.0.1:8081;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $http_x_forwarded_for;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_read_timeout 120s;
        }

        # HTML is the one thing whose URL never changes when its content does,
        # so it must revalidate on every load.
        location / {
            include /etc/nginx/security-headers.conf;
            add_header Cache-Control "no-cache";
            try_files $uri $uri/index.html =404;
        }
    }
}
