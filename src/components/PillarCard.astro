---
interface Props {
	title: string;
	chip: string;
	chipQuiet?: boolean;
	id?: string;
}

const { title, chip, chipQuiet = false, id } = Astro.props;
---

<article class="ae-card" id={id}>
	<div class="ae-card-punch" aria-hidden="true"></div>
	<h3>{title}</h3>
	<slot />
	<span class:list={["ae-chip", { "ae-chip--quiet": chipQuiet }]}>{chip}</span>
</article>
