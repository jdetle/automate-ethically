---
/*
 * The running-stitch divider: a coral thread knotted at both ends. Under
 * stitch-run the dashes march along it; under reduced-motion it is the same
 * stitch, standing still.
 */
interface Props {
	class?: string;
}

const { class: klass } = Astro.props;
---

<div class:list={["ae-stitch", klass]} aria-hidden="true">
	<svg viewBox="0 0 1168 14" preserveAspectRatio="none" fill="none">
		<circle cx="6" cy="7" r="3.5" fill="currentColor"></circle>
		<line
			class="ae-stitch-run"
			x1="14"
			y1="7"
			x2="1154"
			y2="7"
			stroke="currentColor"
			stroke-width="2.5"
			stroke-dasharray="11 8"></line>
		<circle cx="1162" cy="7" r="3.5" fill="currentColor"></circle>
	</svg>
</div>

<style>
	.ae-stitch {
		color: var(--ae-coral);
		padding: 0 var(--ae-gutter);
		margin: 0 auto;
		max-width: var(--ae-max-page);
	}

	.ae-stitch svg {
		display: block;
		width: 100%;
		height: 14px;
	}

	.ae-stitch-run {
		animation: ae-stitch-run 2.4s linear infinite;
	}
</style>
