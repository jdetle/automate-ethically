<style>
	.ae-footer {
		border-top: 1px solid var(--ae-line);
		padding: 26px var(--ae-gutter) 34px;
		max-width: var(--ae-max-page);
		margin: 0 auto;
		font-size: var(--ae-fs-meta);
		color: var(--ae-muted);
	}

	.ae-footer-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.ae-footer-claim {
		margin: 0;
		max-width: 42ch;
		line-height: 1.6;
	}

	.ae-footer-nav {
		display: flex;
		gap: 1.1rem;
		flex-wrap: wrap;
	}

	.ae-footer-nav a {
		font-weight: 600;
		color: var(--ae-ink);
		text-decoration: none;
	}

	.ae-footer-nav a:hover {
		color: var(--ae-cobalt);
		text-decoration: underline;
	}

	.ae-footer-mark {
		font-family: var(--ae-mono);
		color: var(--ae-faint);
	}

	.ae-footer-row--quiet {
		margin-top: 1.6rem;
		padding-top: 1.2rem;
		border-top: 1px solid var(--ae-line-soft);
		font-size: 0.72rem;
		color: var(--ae-faint);
	}

	.ae-footer-row--quiet p {
		margin: 0;
		max-width: 78ch;
		line-height: 1.65;
	}

	.ae-footer-sign {
		white-space: nowrap;
	}
</style>
