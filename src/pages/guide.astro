---
import Page from "../layouts/Page.astro";
import Stitch from "../components/ui/Stitch.astro";
import GuideOrb from "../components/GuideOrb.astro";

// Public by design — a Turnstile site key is meant to be embedded in every
// page that uses it, the same as any other widget key. The secret half
// (TURNSTILE_SECRET_KEY) is server-only, read in api/guide.ts and
// api/speech.ts, and never appears here. Empty until set (see README): the
// widget then never renders, and both API routes fail closed regardless —
// there's no path where a human-verification gate silently doesn't apply.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<Page
	title="Talk it through | Automate Ethically"
	description="A conversation about what's organizing near you, and how your own skills fit in."
	ogImage="/og/guide.png"
>
	<section class="ae-hero ae-guide-hero" aria-labelledby="guide-title">
		<div class="ae-guide-hero-copy">
			<p class="ae-eyebrow">Talk it through</p>
			<!-- DRAFT: rewrite — copy task 27: /guide framing -->
			<h1 id="guide-title">What's organizing near you, and where you fit.</h1>
			<p class="ae-hero-sub">
				Tell it your town and what you're good at, and it'll look for what's
				actually happening there and think through it with you. It searches
				the live web for real, current information; it won't invent a group
				or a meeting that doesn't exist, and it says so when it can't find
				anything concrete.
			</p>
		</div>
		<!--
			The orb is the conversation's state — idle, listening, thinking,
			searching — so it sits with the status line that names that state in
			words. On desktop the pair moves up beside the headline, where the
			hero has room for it; on narrow screens it drops back under the copy.
			There is exactly one instance: GuideOrb binds a single canvas.
		-->
		<div class="ae-guide-head">
			<GuideOrb size={340} />
			<div class="ae-guide-head-text">
				<div class="ae-guide-status" id="guide-status" role="status" aria-live="polite">
					Ready when you are.
				</div>
				<button type="button" class="ae-guide-voice" id="guide-voice" hidden aria-pressed="false">
					<span aria-hidden="true">🔊</span> Read replies aloud
				</button>
			</div>
		</div>
	</section>

	<Stitch />

	<section class="ae-section" aria-label="Conversation">
		<div class="ae-container ae-guide">
			<div class="ae-guide-suggestions" id="guide-suggestions" hidden>
				<p class="ae-guide-location" id="guide-location-line">
					<span id="guide-location-text"></span>
					<button type="button" class="ae-guide-location-edit" id="guide-location-edit">change it</button>
				</p>
				<div class="ae-guide-location-form" id="guide-location-form" hidden>
					<input
						type="text"
						id="guide-location-input"
						class="ae-guide-location-input"
						placeholder="Your city, or your state"
						aria-label="Your location"
					/>
					<button type="button" class="ae-btn" id="guide-location-save">Use this</button>
				</div>
				<div class="ae-guide-chips" id="guide-chips" role="list" aria-label="Suggested things to ask"></div>
			</div>

			<div class="ae-guide-transcript" id="guide-transcript"></div>

			<div class="ae-guide-verify" id="guide-verify" hidden>
				<p class="ae-guide-verify-hint">
					One quick check before you can send anything. A box appears below
					only if Cloudflare decides it needs to see you click it.
				</p>
				<div id="guide-turnstile" data-sitekey={turnstileSiteKey}></div>
			</div>

			<form class="ae-guide-form" id="guide-form">
				<textarea
					id="guide-input"
					class="ae-guide-input"
					placeholder="Verifying you're human…"
					rows="2"
					aria-label="Message"
					disabled
				></textarea>
				<button type="submit" class="ae-btn ae-btn--primary ae-btn--lg" id="guide-send" disabled>
					Send
				</button>
			</form>
			<details class="ae-guide-disclosure">
				<summary>Exactly what this page sends, and to whom</summary>
				<div class="ae-guide-disclosure-body">
					<p>
						A site arguing that automated decisions should be answerable
						shouldn't ask you to take its own on faith. So, in full:
					</p>
					<h3>Leaves your browser</h3>
					<ul>
						<li>
							<strong>What you type</strong>, plus the earlier turns of this
							conversation, to this site's server, and from there to
							<strong>Anthropic</strong> (the model is <code>claude-opus-5</code>).
							Held in your tab's memory only. Closing the tab ends it.
						</li>
						<li>
							<strong>Your IP address</strong>, unavoidably, as with any web
							request. Used for three things and no others: a one-time
							city-level guess to seed the suggested questions above (via
							<a href="https://ipapi.co" rel="noreferrer">ipapi.co</a>), rate
							limiting, and the human check below. Never written to a database.
						</li>
						<li>
							<strong>A human-verification check</strong> to
							<strong>Cloudflare Turnstile</strong>, once per session, not
							once per message. It exists so an automated script can't run up
							a bill on a movement site.
						</li>
						<li>
							<strong>The guide's replies</strong> go to <strong>OpenAI</strong>
							for text-to-speech, but only while you have voice switched on.
							Off by default.
						</li>
						<li>
							<strong>Whatever the guide searches for.</strong> When it looks
							something up, the search terms it chose reach a web-search
							provider through Anthropic. Every reply that used a search shows
							you the exact queries and the sites it read. Expand
							"what this answer is based on" under any reply.
						</li>
					</ul>
					<h3>Does not happen</h3>
					<ul>
						<li>No cookies, no <code>localStorage</code> identifier, no persistent ID of any kind.</li>
						<li>Your conversation is never stored on the server, never logged, and never used for training.</li>
						<li>No advertising or analytics network sees any of this. Page-count analytics run on our own infrastructure and don't receive what you type.</li>
						<li>Nothing you type is attached to your IP anywhere.</li>
					</ul>
					<p class="ae-guide-disclosure-foot">
						The code is open: <a href="https://github.com/jdetle/automate-ethically/blob/main/src/pages/api/guide.ts" rel="noreferrer">the route that does all this</a>.
						More on the site's data stance: <a href="/facts">how this site handles data</a>.
					</p>
				</div>
			</details>
			<p class="ae-aside">
				Prefer not to talk to a model at all?
				<a href="/act">Skip straight to the action list</a>.
			</p>
		</div>
	</section>
</Page>

<!--
	Turnstile has to load from Cloudflare's own edge to mean anything — the
	one deliberate third-party-script exception on this page (see README's
	JS policy and nginx-security-headers.conf's CSP comment). `render=explicit`
	because the widget below is created by hand once the site key is known,
	not auto-attached to a `cf-turnstile` class.
-->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

<script>
	import { decayOrb, pulseFromText, setLevelAndSpectrum, setOrbConversationState } from "../lib/guide-orb-state";
	import {
		audioContextReady,
		speechConfigured,
		startSpeech,
		type SpeechSession,
		unlockAudio,
	} from "../lib/speech-playback";
	import { renderMarkdownInto } from "../lib/markdown-dom";

	const VOICE_KEY = "ae-guide-voice";

	// ---- Turnstile: one challenge per session (see ensureSession below) --
	declare global {
		interface Window {
			/** Defined by public/beacon.js. Absent if a blocker ate it. */
			aeSignal?: (name: string, attributes?: Record<string, string>) => void;
			turnstile?: {
				render: (container: HTMLElement | string, options: Record<string, unknown>) => string;
				execute: (widgetId: string) => void;
				reset: (widgetId: string) => void;
			};
		}
	}

	/**
	 * Reports one guide-side fact to our own analytics (see public/beacon.js
	 * and /privacy for the whole field list). Short fixed strings only — never
	 * a question, a reply, or anything typed.
	 *
	 * This is here because of what the audio bug cost: the server log can say
	 * "no audio was ever requested" but not whether anybody asked for any, so
	 * four fixes were shipped on inference about which of those it was. Best
	 * effort by design — a blocked beacon must never affect the page.
	 */
	function signal(name: string, attributes?: Record<string, string>) {
		try {
			window.aeSignal?.(name, attributes);
		} catch {
			/* analytics must never break the guide */
		}
	}

	const turnstileContainer = document.querySelector<HTMLDivElement>("#guide-turnstile");
	const turnstileSiteKey = turnstileContainer?.dataset.sitekey ?? "";
	let turnstileWidgetId: string | null = null;
	let pendingTokenResolve: ((token: string) => void) | null = null;
	let pendingTokenReject: ((err: Error) => void) | null = null;
	// Distinguishes one token request from the next, so a late timeout from a
	// finished request can never reject the request that replaced it.
	let turnstileRequestId = 0;

	// The widget lives inside #guide-verify. That wrapper MUST be visible for
	// the whole time a token is being minted — Cloudflare can decide at any
	// moment that it needs to show a checkbox, and a challenge inside a
	// `hidden` ancestor has nowhere to render, so it can never be satisfied.
	// An earlier version hid the wrapper for good once the page-load check
	// cleared, which left every later token request (each send mints its own)
	// running against a sealed widget: the page said "Ready when you are.",
	// then the first message came back "Couldn't verify you're human." An
	// invisible always-pass test key hid this in testing; a real managed
	// widget hit it immediately.
	function setVerifyVisible(visible: boolean) {
		const wrap = document.querySelector<HTMLDivElement>("#guide-verify");
		if (wrap) wrap.hidden = !visible;
	}

	// Settles whichever getTurnstileToken() call is currently pending. This
	// MUST capture pendingTokenResolve/pendingTokenReject into locals before
	// clearing the outer variables: the previous version cleared them first
	// and then invoked a closure that read the (now-null) outer variables at
	// call time, not the values captured when the closure was created — so
	// resolve()/reject() silently never ran. A real Cloudflare success would
	// log a token and then just hang forever, input stuck disabled, with no
	// error and no visible cause — the single worst failure mode this file
	// could have, since it looks identical to "still loading."
	function settleTurnstile(kind: "resolve" | "reject", payload: string | Error) {
		const resolve = pendingTokenResolve;
		const reject = pendingTokenReject;
		pendingTokenResolve = null;
		pendingTokenReject = null;
		turnstileRequestId += 1;
		setVerifyVisible(false);
		if (kind === "resolve" && typeof payload === "string") resolve?.(payload);
		if (kind === "reject" && payload instanceof Error) reject?.(payload);
	}

	// The Cloudflare script tag below is `async defer` — it can finish
	// downloading and execute either before or after this module script,
	// there's no guaranteed order between them. Calling anything on
	// `window.turnstile` without waiting for it first is a real race, not a
	// hypothetical one: on a fast page load (a warm cache, a fast machine —
	// exactly the conditions a real visitor or a test run both hit) this
	// script can reach the widget-setup code before Cloudflare's script has
	// finished loading, and `window.turnstile` is simply `undefined` yet.
	// That produced an *immediate*, silent "verification isn't available"
	// rejection with no network round trip at all — easy to mistake for a
	// real Cloudflare rejection (bot detection, a misconfigured widget) when
	// it was actually a load-order bug in this file. Confirmed the fix with
	// Cloudflare's own always-pass test keys (docs/…, tests/guide.e2e.spec.ts)
	// rather than the real widget — see that test file for why.
	function waitForTurnstile(timeoutMs = 8000): Promise<boolean> {
		if (window.turnstile) return Promise.resolve(true);
		return new Promise((resolve) => {
			const deadline = performance.now() + timeoutMs;
			const check = () => {
				if (window.turnstile) {
					resolve(true);
					return;
				}
				if (performance.now() >= deadline) {
					resolve(false);
					return;
				}
				setTimeout(check, 50);
			};
			check();
		});
	}

	function ensureTurnstileWidget(): boolean {
		if (turnstileWidgetId !== null) return true;
		if (!window.turnstile || !turnstileContainer || !turnstileSiteKey) return false;
		turnstileWidgetId = window.turnstile.render(turnstileContainer, {
			sitekey: turnstileSiteKey,
			appearance: "interaction-only",
			execution: "execute",
			callback: (token: string) => settleTurnstile("resolve", token),
			"error-callback": () => settleTurnstile("reject", new Error("verification error")),
			"expired-callback": () => settleTurnstile("reject", new Error("verification expired")),
		});
		return true;
	}

	/** Mints one fresh Turnstile token. Only ensureSession() should call this. */
	async function getTurnstileToken(): Promise<string> {
		const ready = await waitForTurnstile();
		return new Promise((resolve, reject) => {
			if (!ready || !ensureTurnstileWidget() || turnstileWidgetId === null || !window.turnstile) {
				reject(new Error("verification isn't available right now"));
				return;
			}
			pendingTokenResolve = resolve;
			pendingTokenReject = reject;
			// Visible for the whole request, every time — Cloudflare may need
			// to show a checkbox on any call, not just the first.
			setVerifyVisible(true);
			const thisRequest = turnstileRequestId;
			window.turnstile.reset(turnstileWidgetId);
			window.turnstile.execute(turnstileWidgetId);
			setTimeout(() => {
				// Only time out the request this timer was started for. Without
				// the id check, a finished request's stale timer could fire
				// while a *later* request was pending and reject that one
				// instead — a rare, near-impossible-to-reproduce failure.
				if (thisRequest === turnstileRequestId && pendingTokenReject) {
					settleTurnstile("reject", new Error("verification timed out"));
				}
			}, 15000);
		});
	}

	// ---- Session: clear one challenge, not one per message ---------------
	// The guide used to mint a fresh Turnstile token for every API call — one
	// per message, plus another for every spoken reply. Cloudflare's managed
	// widget reads that repetition as scripted traffic and escalates to
	// interactive challenges, so a real person got a checkbox in front of
	// every single message and the conversation never went anywhere. Now one
	// Turnstile pass is traded at /api/session for a short-lived signed token
	// (see lib/guide-session.ts) that the paid routes accept.
	let sessionToken: string | null = null;
	let sessionExpiresAt = 0;
	let sessionInFlight: Promise<string> | null = null;

	async function requestSession(): Promise<string> {
		const turnstileToken = await getTurnstileToken();
		const res = await fetch("/api/session", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ turnstileToken }),
		});
		if (!res.ok) throw new Error("session request failed");
		const data = (await res.json()) as { sessionToken?: string; expiresAt?: number };
		if (!data.sessionToken) throw new Error("session request returned nothing");
		sessionToken = data.sessionToken;
		// Renew a minute early so a request can't set out with a token that
		// expires in flight.
		sessionExpiresAt = (data.expiresAt ?? Date.now()) - 60_000;
		return data.sessionToken;
	}

	/**
	 * Returns a valid session token, verifying with Turnstile only when there
	 * isn't one. Concurrent callers share a single in-flight request rather
	 * than each firing their own challenge.
	 */
	function ensureSession(): Promise<string> {
		if (sessionToken && Date.now() < sessionExpiresAt) return Promise.resolve(sessionToken);
		if (sessionInFlight) return sessionInFlight;
		sessionInFlight = requestSession().finally(() => {
			sessionInFlight = null;
		});
		return sessionInFlight;
	}

	/** Drops the current session so the next call re-verifies from scratch. */
	function invalidateSession() {
		sessionToken = null;
		sessionExpiresAt = 0;
	}

	interface Turn {
		role: "user" | "assistant";
		text: string;
	}

	const form = document.querySelector<HTMLFormElement>("#guide-form");
	const input = document.querySelector<HTMLTextAreaElement>("#guide-input");
	const sendBtn = document.querySelector<HTMLButtonElement>("#guide-send");
	const transcript = document.querySelector<HTMLDivElement>("#guide-transcript");
	const status = document.querySelector<HTMLDivElement>("#guide-status");
	const voiceBtn = document.querySelector<HTMLButtonElement>("#guide-voice");

	const history: Turn[] = [];
	let busy = false;
	// Not read from the DOM: the textarea's markup placeholder is
	// "Verifying you're human…" until the gate below clears, so the real
	// placeholder has to live here instead.
	const READY_PLACEHOLDER = "Your town, what you're good at, or just say hi";

	// ---- Verify before you can type a word ------------------------------
	// The old flow rendered Turnstile lazily, on first send — a person could
	// type a whole message before ever learning a check existed, then watch
	// "Thinking…" sit there while an easy-to-miss checkbox waited below.
	// Gating the textbox itself up front makes the check impossible to miss
	// and impossible to type past. This first pass only proves "a human is
	// here" — every actual send still mints its own fresh token below
	// (getTurnstileToken never caches one), so redeeming this one doesn't
	// let a later API call skip verification.
	async function verifyBeforeTyping() {
		if (!turnstileSiteKey) {
			// No widget configured client-side at all. The server fails closed
			// regardless (api/guide.ts, api/speech.ts) — a client-side gate with
			// nothing to gate on would just lock out local dev for no reason.
			if (input) {
				input.disabled = false;
				input.placeholder = READY_PLACEHOLDER;
			}
			if (sendBtn) sendBtn.disabled = false;
			return;
		}
		if (status) status.textContent = "Verifying you're human…";
		// Visibility is getTurnstileToken()'s job now, for every call — not
		// just this one. See setVerifyVisible() for why that matters.
		try {
			// One challenge, traded for a session that covers the whole
			// conversation — messages and spoken replies alike.
			await ensureSession();
			if (status) status.textContent = "Ready when you are.";
		} catch {
			if (status) status.textContent = "Couldn't verify you're human. Reload the page to try again.";
			return;
		}
		if (input) {
			input.disabled = false;
			input.placeholder = READY_PLACEHOLDER;
		}
		if (sendBtn) sendBtn.disabled = false;
	}

	void verifyBeforeTyping();

	// ---- Suggested prompts, seeded from a disclosed, throwaway location
	// guess (src/pages/api/geo.ts). Never a claim, always a guess the
	// visitor can overrule in one click — see the "change it" button below.
	const PROMPT_TEMPLATES = [
		(place: string) => `What's organizing around ${place} right now?`,
		(place: string) => `Is ${place}'s city council discussing AI, surveillance, or automated decisions?`,
		(place: string) => `I live near ${place}. Where should I start?`,
		(place: string) => `Are there local groups near ${place} already working on this?`,
		(place: string) => `What does the state-level landscape look like for ${place}?`,
	];

	const suggestions = document.querySelector<HTMLDivElement>("#guide-suggestions");
	const locationLine = document.querySelector<HTMLParagraphElement>("#guide-location-line");
	const locationText = document.querySelector<HTMLSpanElement>("#guide-location-text");
	const locationEditBtn = document.querySelector<HTMLButtonElement>("#guide-location-edit");
	const locationForm = document.querySelector<HTMLDivElement>("#guide-location-form");
	const locationInput = document.querySelector<HTMLInputElement>("#guide-location-input");
	const locationSaveBtn = document.querySelector<HTMLButtonElement>("#guide-location-save");
	const chipsEl = document.querySelector<HTMLDivElement>("#guide-chips");

	function renderChips(place: string | null) {
		if (!chipsEl) return;
		const label = place ?? "your area";
		chipsEl.innerHTML = "";
		for (const template of PROMPT_TEMPLATES) {
			const chip = document.createElement("button");
			chip.type = "button";
			chip.className = "ae-guide-chip";
			chip.setAttribute("role", "listitem");
			chip.textContent = template(label);
			chip.addEventListener("click", () => {
				if (input) {
					input.value = chip.textContent ?? "";
					input.focus();
				}
			});
			chipsEl.appendChild(chip);
		}
		// Always show the line — a failed/empty guess still needs a way to
		// set a location by hand, it just shouldn't claim a guess it doesn't
		// have.
		if (locationLine) locationLine.hidden = false;
		if (locationText) {
			locationText.textContent = place ? `Guessing you're near ${place}.` : "";
		}
		if (locationEditBtn) locationEditBtn.textContent = place ? "change it" : "Add your location for better suggestions";
		if (suggestions) suggestions.hidden = false;
	}

	function showLocationEditor(show: boolean) {
		if (locationForm) locationForm.hidden = !show;
		if (locationLine) locationLine.hidden = show;
		if (show) locationInput?.focus();
	}

	locationEditBtn?.addEventListener("click", () => showLocationEditor(true));
	locationSaveBtn?.addEventListener("click", () => {
		const typed = locationInput?.value.trim();
		showLocationEditor(false);
		if (typed) renderChips(typed);
	});
	locationInput?.addEventListener("keydown", (e) => {
		if (e.key === "Enter") {
			e.preventDefault();
			locationSaveBtn?.click();
		}
	});

	// One lookup per page load. IP-derived, disclosed, never stored server
	// side either (see api/geo.ts) — if it fails or comes back empty, the
	// chips just fall back to generic "your area" phrasing rather than
	// blocking anything.
	void fetch("/api/geo")
		.then((r) => (r.ok ? r.json() : {}))
		.then((geo: { city?: string; region?: string }) => {
			const place = [geo.city, geo.region].filter(Boolean).join(", ") || null;
			renderChips(place);
		})
		.catch(() => renderChips(null));

	// Silent until asked, same reasoning as jacquard: speech that starts on
	// its own is startling, and the toggle only appears once we know a voice
	// is actually configured server-side.
	let muted = true;
	let currentSpeech: SpeechSession | null = null;

	/**
	 * The label names the action, not the state. It used to read "voice off",
	 * which is the kind of label you have to press to find out what it meant,
	 * and the answer was usually "nothing you wanted". Production logs showed
	 * the consequence plainly: GET /api/speech on every guide load, and not a
	 * single POST. Nobody was turning it on, so nobody ever heard anything.
	 */
	function setVoiceLabel(on: boolean) {
		if (!voiceBtn) return;
		voiceBtn.textContent = "";
		const icon = document.createElement("span");
		icon.setAttribute("aria-hidden", "true");
		icon.textContent = "🔊";
		voiceBtn.append(icon, document.createTextNode(on ? " Reading aloud. Turn off" : " Read replies aloud"));
	}

	// Bound now, not inside the probe below.
	//
	// This listener used to be attached only once speechConfigured() came
	// back. That was survivable while the button was genuinely hidden until
	// then, but once it was given a `display` the `hidden` attribute stopped
	// working and it painted immediately — visible, styled, obviously
	// pressable, and wired to nothing. A click in that window did not toggle,
	// did not warn, and was not replayed when the probe landed; it simply
	// vanished, and the visitor went on to send a message with voice still
	// off. Production showed the shape of it plainly: a guide reply, and no
	// speech request anywhere after it.
	//
	// A control that is on screen must work. The guard is a flag, not the
	// presence of a listener.
	let speechAvailable = false;

	voiceBtn?.addEventListener("click", () => {
		if (!voiceBtn || !speechAvailable) return;
		{
			const turningOn = muted;
			if (turningOn) {
				// MUST be called synchronously in the click handler — see
				// unlockAudio() in speech-playback.ts. Doing this after an await
				// loses the gesture and the context stays silently suspended,
				// which is exactly how "voice on" ended up producing no sound.
				const unlocking = unlockAudio();
				muted = false;
				setVoiceLabel(true);
				voiceBtn.setAttribute("aria-pressed", "true");
				// Someone who turns the voice on after reading a reply almost
				// always wants to hear *that* reply. Offer it rather than
				// making them ask the same question again.
				for (const row of document.querySelectorAll<HTMLDivElement>(".ae-guide-turn")) {
					revealSpeakButton(row);
				}
				void unlocking.then((ok) => {
					if (!ok) {
						// Be honest rather than leaving a toggle that lies.
						muted = true;
						voiceBtn.textContent = "Voice unavailable in this browser";
						voiceBtn.setAttribute("aria-pressed", "false");
						voiceBtn.disabled = true;
					}
				});
			} else {
				muted = true;
				setVoiceLabel(false);
				voiceBtn.setAttribute("aria-pressed", "false");
				currentSpeech?.cancel();
				currentSpeech = null;
				hideSpeakingIndicator();
			}
			signal("guide.voice_toggled", { state: muted ? "off" : "on" });
			try {
				localStorage.setItem(VOICE_KEY, muted ? "off" : "on");
			} catch {
				/* non-fatal */
			}
		}
	});

	/**
	 * Unlocks audio on this visitor's next real interaction — a click anywhere
	 * on the page, a key press, a tap.
	 *
	 * A preference restored at load cannot unlock the context itself: browsers
	 * require a gesture, which is precisely why the preference used to be
	 * thrown away on every load. It does not need to. The next thing someone
	 * on this page does is type a question and press send, and that is a
	 * gesture — so the unlock rides along on it, and by the time a reply comes
	 * back the context has been running for seconds.
	 */
	function armGestureUnlock() {
		const once = () => void unlockAudio();
		document.addEventListener("pointerdown", once, { once: true, capture: true });
		document.addEventListener("keydown", once, { once: true, capture: true });
	}

	void speechConfigured().then((available) => {
		if (!available || !voiceBtn) return;
		speechAvailable = true;
		voiceBtn.hidden = false;

		// Honour the choice this visitor already made. Refusing to restore it
		// is what the production logs were actually describing: eleven
		// conversations across two days, and one single request for audio. The
		// toggle had to be found and pressed again on *every* page load, and
		// pressed *before* typing, or the reply came back silent — because
		// beginSpeech() is decided once, at the top of send(). Restoring the
		// preference is not speech starting unasked: nothing is spoken until a
		// message is sent, and the context is still unlocked by a real gesture
		// (armGestureUnlock above), which is the part Safari actually cares
		// about.
		let stored: string | null = null;
		try {
			stored = localStorage.getItem(VOICE_KEY);
		} catch {
			/* private browsing — treat as no preference */
		}
		muted = stored !== "on";
		setVoiceLabel(!muted);
		voiceBtn.setAttribute("aria-pressed", muted ? "false" : "true");
		if (!muted) armGestureUnlock();
		signal("guide.voice_ready", { state: muted ? "off" : "on", restored: stored ? "yes" : "no" });

		// Replies already on screen become speakable the moment we know a
		// voice exists.
		for (const row of document.querySelectorAll<HTMLDivElement>(".ae-guide-turn")) {
			revealSpeakButton(row);
		}
	});

	// Replies are markdown (headings, lists, links to this site's own pages).
	// renderMarkdownInto parses with marked's lexer and builds DOM nodes
	// directly — never innerHTML — so untrusted model output, which is shaped
	// by both the visitor's text and pages the model read, cannot inject
	// markup. See src/lib/markdown-dom.ts.
	function renderReplyText(el: HTMLElement, text: string) {
		renderMarkdownInto(el, text);
	}

	function appendCursor(el: HTMLElement) {
		const cursor = document.createElement("span");
		cursor.className = "ae-guide-cursor";
		cursor.setAttribute("aria-hidden", "true");
		cursor.textContent = "▍";
		// Sit inside the final block so the caret trails the last word rather
		// than dropping onto a line of its own below a list or heading.
		const last = el.lastElementChild;
		if (last && /^(P|LI|H3|H4)$/.test(last.tagName)) last.appendChild(cursor);
		else el.appendChild(cursor);
	}

	// Which row's "reading aloud" pill is currently shown — at most one at a
	// time, matching currentSpeech being a single global handle.
	let speakingRow: HTMLDivElement | null = null;
	function showSpeakingIndicator(row: HTMLDivElement | null) {
		speakingRow = row;
		const btn = row?.querySelector<HTMLButtonElement>(".ae-guide-turn-speaking");
		if (btn) btn.hidden = false;
	}
	function hideSpeakingIndicator() {
		const btn = speakingRow?.querySelector<HTMLButtonElement>(".ae-guide-turn-speaking");
		if (btn) btn.hidden = true;
		speakingRow = null;
	}

	/**
	 * Says so, instead of nothing.
	 *
	 * A speech request that fails returns quietly all the way down — the reply
	 * is on screen either way, which was the whole argument for silence. But
	 * someone who switched the voice on and heard nothing has no way to tell a
	 * broken key from a browser that refused, from a page that never asked at
	 * all, and every one of those looks identical: "the audio does not work".
	 */
	function noteSpeechFailed(row: HTMLDivElement | null, reason: string) {
		if (!row) return;
		let el = row.querySelector<HTMLParagraphElement>(".ae-guide-turn-note");
		if (!el) {
			el = document.createElement("p");
			el.className = "ae-guide-turn-note";
			el.setAttribute("role", "status");
			row.appendChild(el);
		}
		el.textContent = `Couldn't read this one aloud — ${reason}.`;
	}

	/** Wires a session's callbacks to a row and makes it the current one. */
	function openSpeech(row: HTMLDivElement | null, trigger: string): SpeechSession | null {
		try {
			// The indicator is shown from the onAudible callback, not here.
			// It used to appear the moment a session was constructed, which is
			// before a single byte of audio has been asked for — so a
			// /api/speech that answered 503, or a rejected session token, left
			// "Reading aloud — stop" sitting under a silent reply.
			const session = startSpeech(
				ensureSession,
				setLevelAndSpectrum,
				() => {
					signal("guide.speech", { outcome: "spoken", trigger });
					if (currentSpeech === session) showSpeakingIndicator(row);
				},
				(reason) => {
					signal("guide.speech", { outcome: "silent", trigger, reason });
					noteSpeechFailed(row, reason);
				},
			);
			currentSpeech = session;
			void session.done.then(() => {
				if (currentSpeech === session) {
					currentSpeech = null;
					if (!busy) setOrbConversationState("idle");
				}
				hideSpeakingIndicator();
			});
			return session;
		} catch {
			// Audio unavailable — the text is already on screen, which is the
			// part that matters.
			return null;
		}
	}

	// Speaks the finished reply. Never blocks the conversation — a person can
	// send the next message while the last reply is still being read aloud,
	// same as jacquard.
	/**
	 * Speaks the reply as it is written, not after it is finished.
	 *
	 * Waiting for the whole reply meant a long silence and then a monologue —
	 * which is what "not real time" felt like. This starts a session up front
	 * and hands it each sentence as soon as the model completes one, so the
	 * guide begins talking within a sentence or two of starting to write.
	 */
	function beginSpeech(row: HTMLDivElement | null): SpeechSession | null {
		// audioContextReady(), not a boolean set from unlockAudio().then():
		// resuming a context takes a moment and building one does not, so
		// gating on the resolved result meant that pressing the toggle and
		// sending straight away produced no voice at all under a toggle that
		// said "Reading aloud".
		if (muted || !audioContextReady()) return null;
		return openSpeech(row, "with_reply");
	}

	/**
	 * Speaks a reply that is already on screen.
	 *
	 * Every fix before this one left the same hole: beginSpeech() is decided
	 * once, at the top of send(), so a reply written while the voice was off
	 * could never afterwards be heard. Someone who read a reply, thought "I'd
	 * like to hear that", and pressed the voice toggle got nothing — and
	 * concluded, correctly from where they stood, that the audio is broken.
	 * This is the second chance, and its click is itself the gesture that
	 * unlocks the context.
	 */
	function speakText(row: HTMLDivElement, text: string) {
		const spoken = text.trim();
		if (!spoken) return;
		currentSpeech?.cancel();
		currentSpeech = null;
		hideSpeakingIndicator();
		// Synchronous inside a click handler, which is the one moment a
		// gesture is guaranteed. unlockAudio() builds the context before it
		// awaits anything, so openSpeech() below always has one to use.
		void unlockAudio();
		const session = openSpeech(row, "on_demand");
		if (!session) {
			noteSpeechFailed(row, "this browser wouldn't start audio");
			return;
		}
		session.enqueue(spoken);
		session.end();
	}

	/** Offers the per-reply play control, once we know a voice exists. */
	function revealSpeakButton(row: HTMLDivElement | null) {
		if (!row || !speechAvailable) return;
		const btn = row.querySelector<HTMLButtonElement>(".ae-guide-turn-speak");
		if (btn && row.dataset.spoken) btn.hidden = false;
	}

	/**
	 * Pulls complete sentences off the front of the buffer. Only complete ones:
	 * feeding a half-sentence to TTS produces an audible clip mid-word, and the
	 * remainder is flushed when the stream ends anyway.
	 */
	function takeCompleteSentences(buffer: string): { ready: string; rest: string } {
		// Split after . ! ? or a newline, when followed by whitespace.
		const match = buffer.match(/^[\s\S]*?(?:[.!?](?=\s)|\n)(?=[\s\S])/g);
		if (!match) return { ready: "", rest: buffer };
		const ready = match.join("");
		return { ready, rest: buffer.slice(ready.length) };
	}

	/**
	 * An in-transcript working indicator. The orb says the same thing, but on
	 * a phone the orb has usually scrolled off the top by the time a reply is
	 * being composed — leaving a visitor staring at a blank bubble with no
	 * sign anything is happening. This sits where they are actually looking.
	 */
	function setWorking(row: HTMLDivElement, label: string) {
		let el = row.querySelector<HTMLParagraphElement>(".ae-guide-working");
		if (!el) {
			el = document.createElement("p");
			el.className = "ae-guide-working";
			el.setAttribute("role", "status");
			const textEl = row.querySelector("p");
			row.insertBefore(el, textEl?.nextSibling ?? null);
		}
		el.innerHTML = "";
		el.appendChild(document.createTextNode(label));
		const dots = document.createElement("span");
		dots.className = "ae-guide-working-dots";
		dots.setAttribute("aria-hidden", "true");
		for (let i = 0; i < 3; i++) dots.appendChild(document.createElement("i"));
		el.appendChild(dots);
	}

	function clearWorking(row: HTMLDivElement) {
		row.querySelector(".ae-guide-working")?.remove();
	}

	interface TraceData {
		searches?: { query: string; results: number; domains: string[] }[];
		usage?: { inputTokens: number; outputTokens: number };
	}

	/**
	 * Shows what the model actually did to produce this reply — the searches
	 * it ran, verbatim, and the sites it read. The site's argument is that an
	 * automated decision should be answerable; this is the guide holding
	 * itself to that, per reply, rather than asking to be trusted.
	 */
	function renderTrace(row: HTMLDivElement, data: TraceData) {
		const trace = row.querySelector<HTMLDetailsElement>(".ae-guide-trace");
		if (!trace) return;
		const searches = data.searches ?? [];
		if (searches.length === 0) {
			// No search ran: say so explicitly rather than showing nothing,
			// because "answered from the model's own knowledge" is exactly the
			// kind of thing a reader should be able to weigh.
			trace.innerHTML = "";
			const summary = document.createElement("summary");
			summary.textContent = "No web search: answered from the model's own knowledge";
			trace.appendChild(summary);
			const note = document.createElement("p");
			note.className = "ae-guide-trace-note";
			note.textContent =
				"Nothing here was looked up live, so treat anything specific (a group, a meeting, a date) as unverified.";
			trace.appendChild(note);
			trace.hidden = false;
			return;
		}

		trace.innerHTML = "";
		const summary = document.createElement("summary");
		const totalSites = new Set(searches.flatMap((entry) => entry.domains)).size;
		summary.textContent = `What this answer is based on: ${searches.length} search${searches.length === 1 ? "" : "es"}, ${totalSites} site${totalSites === 1 ? "" : "s"}`;
		trace.appendChild(summary);

		const list = document.createElement("ol");
		list.className = "ae-guide-trace-list";
		for (const entry of searches) {
			const item = document.createElement("li");

			const q = document.createElement("span");
			q.className = "ae-guide-trace-query";
			q.textContent = entry.query ? `searched: “${entry.query}”` : "searched the web";
			item.appendChild(q);

			const meta = document.createElement("span");
			meta.className = "ae-guide-trace-meta";
			meta.textContent =
				entry.results === 0
					? ": no results (that search failed or was cut off)"
					: `: ${entry.results} result${entry.results === 1 ? "" : "s"}`;
			item.appendChild(meta);

			if (entry.domains.length > 0) {
				const sites = document.createElement("span");
				sites.className = "ae-guide-trace-sites";
				sites.textContent = entry.domains.join(" · ");
				item.appendChild(sites);
			}
			list.appendChild(item);
		}
		trace.appendChild(list);

		const note = document.createElement("p");
		note.className = "ae-guide-trace-note";
		note.textContent =
			"These queries were sent to a web-search provider through Anthropic. Nothing about you was attached to them.";
		trace.appendChild(note);
		trace.hidden = false;
	}

	function addTurn(role: Turn["role"], text: string): { row: HTMLDivElement; textEl: HTMLParagraphElement } {
		const row = document.createElement("div");
		row.className = role === "user" ? "ae-guide-turn ae-guide-turn--you" : "ae-guide-turn";

		const label = document.createElement("span");
		label.className = "ae-guide-turn-label";
		label.textContent = role === "user" ? "You" : "The guide";
		row.appendChild(label);


		const p = document.createElement("p");
		renderReplyText(p, text);
		row.appendChild(p);

		if (role === "assistant") {
			const speakingBtn = document.createElement("button");
			speakingBtn.type = "button";
			speakingBtn.className = "ae-guide-turn-speaking";
			speakingBtn.hidden = true;
			speakingBtn.textContent = "🔊 Reading aloud. Tap to stop";
			speakingBtn.addEventListener("click", () => {
				currentSpeech?.cancel();
				currentSpeech = null;
				hideSpeakingIndicator();
			});
			row.appendChild(speakingBtn);

			// The second chance. Hidden until the reply has finished and a
			// voice is known to exist (revealSpeakButton), so it never offers
			// to read an empty bubble or a reply nothing can speak.
			const speakBtn = document.createElement("button");
			speakBtn.type = "button";
			speakBtn.className = "ae-guide-turn-speak";
			speakBtn.hidden = true;
			speakBtn.textContent = "🔊 Read this aloud";
			speakBtn.addEventListener("click", () => speakText(row, row.dataset.spoken ?? ""));
			row.appendChild(speakBtn);

			// Filled in by the "trace" event once the reply completes. Empty
			// (and hidden) for replies that never searched.
			const trace = document.createElement("details");
			trace.className = "ae-guide-trace";
			trace.hidden = true;
			row.appendChild(trace);
		}

		transcript?.appendChild(row);
		if (transcript) transcript.scrollTop = transcript.scrollHeight;
		return { row, textEl: p };
	}

	// A slow decay loop keeps the orb from freezing mid-pulse between text
	// chunks — see guide-orb-state.ts for what actually drives it.
	let lastDecay = performance.now();
	function decayLoop(now: number) {
		const dt = Math.min(0.1, (now - lastDecay) / 1000);
		lastDecay = now;
		decayOrb(dt);
		requestAnimationFrame(decayLoop);
	}
	requestAnimationFrame(decayLoop);

	async function send(message: string) {
		if (busy || !message.trim()) return;
		// A new question stops the previous answer mid-word — the person has
		// moved on, and talking over them is worse than silence.
		currentSpeech?.cancel();
		currentSpeech = null;
		hideSpeakingIndicator();
		busy = true;
		if (sendBtn) sendBtn.disabled = true;
		if (input) input.value = "";

		addTurn("user", message);
		history.push({ role: "user", text: message });
		setOrbConversationState("thinking");
		if (status) status.textContent = "Thinking…";

		const { row: replyRow, textEl: replyP } = addTurn("assistant", "");
		setWorking(replyRow, "Thinking");
		let replyText = "";
		// Opened up front so the first finished sentence can be spoken while
		// the rest is still being written.
		const speech = beginSpeech(replyRow);
		let speechSettled = false;
		let speechBuffer = "";

		try {
			let session: string;
			try {
				session = await ensureSession();
			} catch {
				replyP.textContent = "Couldn't verify you're human. Reload the page and try again.";
				return; // the finally below settles `speech`
			}

			const post = (token: string) =>
				fetch("/api/guide", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ message, history: history.slice(0, -1), sessionToken: token }),
				});

			let res = await post(session);
			// A session can lapse mid-conversation (expiry, or a container
			// restart). Re-verify once and retry rather than making the
			// visitor reload and lose the thread.
			if (res.status === 403) {
				invalidateSession();
				try {
					res = await post(await ensureSession());
				} catch {
					replyP.textContent = "Couldn't verify you're human. Reload the page and try again.";
					return;
				}
			}

			if (!res.ok || !res.body) {
				const err = await res.json().catch(() => ({ error: "Something went wrong." }));
				replyP.textContent = err.error ?? "Something went wrong.";
				setOrbConversationState("idle");
				if (status) status.textContent = "Ready when you are.";
				return;
			}

			const reader = res.body.getReader();
			const decoder = new TextDecoder();
			let buffer = "";
			let errored = false;

			for (;;) {
				const { done, value } = await reader.read();
				if (done) break;
				buffer += decoder.decode(value, { stream: true });

				const events = buffer.split("\n\n");
				buffer = events.pop() ?? "";

				for (const raw of events) {
					const lines = raw.split("\n");
					const eventLine = lines.find((l) => l.startsWith("event: "));
					const dataLine = lines.find((l) => l.startsWith("data: "));
					if (!eventLine || !dataLine) continue;
					const event = eventLine.slice(7).trim();
					const data = JSON.parse(dataLine.slice(6));

					if (event === "phase" && data.phase === "researching") {
						setOrbConversationState("searching");
						if (status) status.textContent = "Searching the web…";
						setWorking(replyRow, "Searching the web");
					} else if (event === "phase" && data.phase === "speaking") {
						setOrbConversationState("speaking");
						if (status) status.textContent = "…";
						clearWorking(replyRow);
					} else if (event === "text") {
						replyText += data.text;
						renderReplyText(replyP, replyText);
						appendCursor(replyP);
						if (speech) {
							speechBuffer += data.text;
							const { ready, rest } = takeCompleteSentences(speechBuffer);
							speechBuffer = rest;
							if (ready.trim()) speech.enqueue(ready);
						} else {
							// No voice this turn: the orb falls back to its
							// text-arrival pulse so it still reacts to the reply.
							pulseFromText(data.text);
						}
						if (transcript) transcript.scrollTop = transcript.scrollHeight;
					} else if (event === "trace") {
						renderTrace(replyRow, data as TraceData);
					} else if (event === "error") {
						// A guardrail can fire mid-stream (see api/guide.ts) after
						// some safe text has already arrived — this replaces the
						// whole bubble with the refusal rather than appending to
						// it, so nothing before the line gets crossed stays on
						// screen next to it.
						errored = true;
						speech?.cancel();
						speechSettled = true;
						replyP.textContent = data.message;
					}
				}
			}

			if (!errored) {
				// Final render, cursor-free — the loop above leaves a blinking
				// cursor on every chunk since it can't tell "more is coming"
				// from "that was the last one" until the stream actually ends.
				renderReplyText(replyP, replyText);
				history.push({ role: "assistant", text: replyText });
				// Speakable from now on, whether or not it was spoken live.
				replyRow.dataset.spoken = replyText;
				revealSpeakButton(replyRow);
				// The measurement that was missing. "No audio was requested"
				// and "audio was requested and failed" look identical in the
				// server log, and guessing between them is what made this bug
				// survive four fixes.
				if (!speech) {
					signal("guide.speech", {
						outcome: "not_requested",
						voice: muted ? "off" : "on",
						audio: audioContextReady() ? "unlocked" : "locked",
					});
				}
				if (speech) {
					if (speechBuffer.trim()) speech.enqueue(speechBuffer);
					speech.end();
					speechSettled = true;
				}
			}
		} catch {
			replyP.textContent = "Couldn't reach the guide — check your connection and try again.";
		} finally {
			// Every exit from this function has to settle the session. Two did
			// not: the "couldn't verify you're human" return above, and the
			// network-failure catch. Both left a live session whose `done`
			// never resolved, which is what pinned "Reading aloud — stop"
			// under a reply that was never read aloud.
			if (speech && !speechSettled) speech.cancel();
			clearWorking(replyRow);
			if (!currentSpeech) setOrbConversationState("idle");
			if (status) status.textContent = "Ready when you are.";
			busy = false;
			if (sendBtn) sendBtn.disabled = false;
			input?.focus();
		}
	}

	form?.addEventListener("submit", (e) => {
		e.preventDefault();
		if (input) void send(input.value);
	});

	input?.addEventListener("input", () => {
		setOrbConversationState(document.activeElement === input && input.value.length > 0 ? "listening" : "idle");
	});

	input?.addEventListener("keydown", (e) => {
		if (e.key === "Enter" && !e.shiftKey) {
			e.preventDefault();
			form?.requestSubmit();
		}
	});
</script>

<style is:global>
	/*
	 * This page runs the full width of the window rather than the site's
	 * 1280px page measure. Everywhere else that cap is doing real work — it
	 * keeps a column of argument readable. Here the page is a workspace: a
	 * text box you type paragraphs into, a row of suggestion chips, and a
	 * transcript. Capping those at 1280 left most of a wide screen empty
	 * while the box you actually use stayed small.
	 *
	 * Line length is still capped, just further in: the hero copy and each
	 * reply set their own measure, so "full width" never means a 200-character
	 * line of prose.
	 */
	.ae-guide {
		max-width: none;
		margin-inline: 0;
	}

	.ae-guide-hero {
		display: grid;
		gap: 2rem;
		max-width: none;
	}

	.ae-guide-hero-copy {
		max-width: 46rem;
	}

	/*
	 * Lift the page cap for this route by retargeting the token every layout
	 * reads, rather than overriding each consumer. Header and footer style
	 * themselves in their own scoped blocks, so a global `.ae-header` rule
	 * here loses the specificity fight (scoped selectors carry the
	 * data-astro-cid attribute); the variable reaches them regardless, and
	 * takes the stitch dividers with it.
	 *
	 * This ships only with /guide — Astro bundles a page's CSS per page,
	 * is:global or not — so nothing else loses the 1280px cap.
	 */
	:root {
		--ae-max-page: none;
	}

	.ae-guide-head {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.ae-guide-head-text {
		display: flex;
		flex-direction: column;
		gap: 8px;
		align-items: flex-start;
	}

	@media (min-width: 900px) {
		.ae-guide-hero {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
			gap: 3rem;
		}

		/* Beside the headline rather than under it, so the hero's right half
		   isn't dead space. */
		.ae-guide-head {
			flex-direction: column;
			gap: 16px;
		}

		.ae-guide-head-text {
			align-items: center;
			text-align: center;
		}

		.ae-guide-status {
			font-size: 15px;
		}
	}

	/*
	 * GuideOrb sizes its canvas from the prop and stretches it to the box, so
	 * these only change how much room it takes — it stays sharp at every step.
	 */
	@media (max-width: 899px) {
		.ae-guide-head .ae-orb {
			--orb-size: 140px;
			width: 140px;
			height: 140px;
		}
	}

	@media (min-width: 900px) and (max-width: 1279px) {
