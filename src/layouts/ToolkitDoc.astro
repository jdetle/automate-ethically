---
import Page from "./Page.astro";
import Stitch from "../components/ui/Stitch.astro";

interface Props {
	title: string;
	description: string;
	updated: Date;
	printable: boolean;
	legalReview?: boolean;
}

const { title, description, updated, printable, legalReview = false } = Astro.props;
// YAML frontmatter dates parse as UTC midnight; formatting in the build
// machine's local timezone can roll the date back a day west of UTC.
// Force UTC so "2026-08-29" always reads as August 29, everywhere.
const updatedLabel = updated.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
});
---

<Page title={`${title} | Automate Ethically`} description={description}>
	<section class="ae-hero ae-printable" aria-labelledby="doc-title">
		<p class="ae-eyebrow"><a href="/toolkit">&larr; The toolkit</a></p>
		<h1 id="doc-title">{title}</h1>
		<p class="ae-hero-sub">{description}</p>
		<p class="ae-aside">Last checked {updatedLabel}.</p>
		{
			legalReview && (
				<p class="ae-legal-notice">
					<strong>This is a starting draft for discussion, not legal
					advice.</strong> It has not been reviewed by an attorney. Your
					city attorney will and should rewrite it before it goes anywhere
					near a vote.
				</p>
			)
		}
		{
			printable && (
				<p class="ae-note">
					This page is built to be printed. Use your browser's print
					option (<strong>File, then Print</strong>) and it will come out
					on one clean page.
				</p>
			)
		}
	</section>

	<Stitch />

	<section class="ae-section" aria-label={title}>
		<div class="ae-container ae-prose ae-printable">
			<slot />
		</div>
	</section>
</Page>
